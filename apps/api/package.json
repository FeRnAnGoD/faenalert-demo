{
  "name": "@faenalert/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start:prod": "node dist/main.js",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "test": "tsx --test test/*.test.ts",
    "test:integration": "tsx test/run-integration.ts",
    "test:e2e": "tsx test/run-browser-e2e.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.4.0",
    "dotenv": "^17.2.0",
    "helmet": "^8.1.0",
    "jose": "^6.1.0",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2"
  },
  "files": [
    "dist",
    "migrations",
    "README.md"
  ]
}
